# Experimental Termux-hosted Android ARM64 cross-target.
# CMAKE_SYSTEM_NAME deliberately stays Linux: CMake's built-in Android toolchain
# expects Google's Linux x86_64-host clang, which is not executable on Android.
set(CMAKE_SYSTEM_NAME Linux)
set(CMAKE_SYSTEM_PROCESSOR aarch64)

if(NOT ANDROID_NDK_SYSROOT)
  set(ANDROID_NDK_SYSROOT "$ENV{ANDROID_NDK_SYSROOT}" CACHE PATH "Android NDK sysroot")
endif()
if(NOT ANDROID_NDK_SYSROOT OR NOT IS_DIRECTORY "${ANDROID_NDK_SYSROOT}/usr/include/c++/v1")
  message(FATAL_ERROR "Set ANDROID_NDK_SYSROOT to the extracted NDK sysroot (it must contain usr/include/c++/v1).")
endif()

set(ANDROID_API 33 CACHE STRING "Minimum Android API for the ARM64 app")
if(NOT ANDROID_API MATCHES "^[0-9]+$")
  message(FATAL_ERROR "ANDROID_API must be a numeric API level")
endif()
list(APPEND CMAKE_TRY_COMPILE_PLATFORM_VARIABLES ANDROID_NDK_SYSROOT ANDROID_API ANDROID_CLANG_RESOURCE_DIR)

if(DEFINED ENV{CC} AND NOT "$ENV{CC}" STREQUAL "")
  set(CMAKE_C_COMPILER "$ENV{CC}" CACHE FILEPATH "Termux Clang C compiler")
else()
  find_program(_TERMUX_CLANG clang REQUIRED)
  set(CMAKE_C_COMPILER "${_TERMUX_CLANG}" CACHE FILEPATH "Termux Clang C compiler")
endif()
if(DEFINED ENV{CXX} AND NOT "$ENV{CXX}" STREQUAL "")
  set(CMAKE_CXX_COMPILER "$ENV{CXX}" CACHE FILEPATH "Termux Clang C++ compiler")
else()
  find_program(_TERMUX_CLANGXX clang++ REQUIRED)
  set(CMAKE_CXX_COMPILER "${_TERMUX_CLANGXX}" CACHE FILEPATH "Termux Clang C++ compiler")
endif()

set(CMAKE_SYSROOT "${ANDROID_NDK_SYSROOT}")
set(CMAKE_C_COMPILER_TARGET "aarch64-linux-android${ANDROID_API}")
set(CMAKE_CXX_COMPILER_TARGET "aarch64-linux-android${ANDROID_API}")
set(_TERMUX_RT_FLAGS "")
if(DEFINED ANDROID_CLANG_RESOURCE_DIR AND IS_DIRECTORY "${ANDROID_CLANG_RESOURCE_DIR}")
  set(_TERMUX_RT_FLAGS "-resource-dir=${ANDROID_CLANG_RESOURCE_DIR}")
elseif(DEFINED ENV{XBO_CLANG_RESOURCE_DIR} AND IS_DIRECTORY "$ENV{XBO_CLANG_RESOURCE_DIR}")
  set(_TERMUX_RT_FLAGS "-resource-dir=$ENV{XBO_CLANG_RESOURCE_DIR}")
endif()
set(CMAKE_C_FLAGS_INIT "${_TERMUX_RT_FLAGS} --rtlib=compiler-rt -fuse-ld=lld")
set(CMAKE_CXX_FLAGS_INIT "${_TERMUX_RT_FLAGS} --rtlib=compiler-rt -stdlib=libc++ -nostdlib++ -isystem ${ANDROID_NDK_SYSROOT}/usr/include/c++/v1 -fuse-ld=lld")
set(CMAKE_CXX_STANDARD_LIBRARIES "-lc++_shared" CACHE STRING "Android shared C++ runtime")
set(CMAKE_EXE_LINKER_FLAGS_INIT "${_TERMUX_RT_FLAGS} --rtlib=compiler-rt -stdlib=libc++ -fuse-ld=lld")
set(CMAKE_SHARED_LINKER_FLAGS_INIT "${_TERMUX_RT_FLAGS} --rtlib=compiler-rt -stdlib=libc++ -nostdlib++ -fuse-ld=lld -Wl,-z,max-page-size=16384 -Wl,-z,common-page-size=16384")
set(CMAKE_MODULE_LINKER_FLAGS_INIT "${_TERMUX_RT_FLAGS} --rtlib=compiler-rt -stdlib=libc++ -nostdlib++ -fuse-ld=lld -Wl,-z,max-page-size=16384 -Wl,-z,common-page-size=16384")

set(CMAKE_FIND_ROOT_PATH "${ANDROID_NDK_SYSROOT}")
set(CMAKE_LIBRARY_PATH "${ANDROID_NDK_SYSROOT}/usr/lib/aarch64-linux-android/${ANDROID_API};${ANDROID_NDK_SYSROOT}/usr/lib/aarch64-linux-android")
set(CMAKE_INCLUDE_PATH "${ANDROID_NDK_SYSROOT}/usr/include")
set(CMAKE_FIND_ROOT_PATH_MODE_PROGRAM NEVER)
set(CMAKE_FIND_ROOT_PATH_MODE_LIBRARY ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_INCLUDE ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_PACKAGE ONLY)
# Keep CMake's default executable try_compile: SDL3 probes linker options via
# check_c_source_compiles, and STATIC_LIBRARY would pass -Wl flags to llvm-ar.
